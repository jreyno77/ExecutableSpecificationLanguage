// PROJECT-36: explicit initial snapshot capture for the manifest-connected project.
// Native ProjectContext adds optional captureSnapshot(): Promise<ProjectSnapshot>.
// CLI's initial gate awaits (captureSnapshot?.() ?? readSnapshot()); absence alone uses the fallback.
// Every later snapshot, journal and writer check retains strict readSnapshot(). No hidden call-order policy.
// No new package dependency: existing Node filesystem APIs and @types/node build requirements suffice.
// File tuples are dev, ino, mode, size, mtimeNs, ctimeNs. Existing root/directory/link/path checks stay strict.
// Keep traversal exclusions, four-slot concurrency and ordinal reporting unchanged; settle every started branch/close.
// Stable acquisition keeps the existing status observations with no added stat call; only eligible confirmation adds work.
// First named/opened tuples must agree. Only post-body ctime drift with named-after == descriptor-after qualifies.
// Close first successfully, then one fresh strict read anchored to the entire settled candidate tuple.
// Both actual bodies must be byte-identical and both closes succeed. Never retry errors or a second transition.
// A suspect candidate is absent on refusal; unrelated successful files remain visible. No writes occur here.
// Preserve the existing ordinary strict-read partial result on a stable-file close error.
// These examples are authored specifications, not observed test results. Controlled faults forward real reads.
examples {
  fixture fileName: Text = ".gitattributes"
  fixture original: Text = "*.expec text eol=lf\n"
  fixture replacement: Text = "*.expec text eol=cr\n"

  setup snapshotProject(fileName: Text, text: Text) returns Nothing
  // Record the real initial capture; assertions remain explicit in the scenario's checks.
  setup capturedSnapshotProject(fileName: Text, text: Text) returns Nothing
  setup statusChangesDuringRead(phase: Text) returns Nothing
  setup modifiedTimeChangesDuringRead() returns Nothing
  setup modeChangesDuringRead() returns Nothing
  setup nameReplacedAfterBody() returns Nothing
  setup replaceBetweenReads(text: Text) returns Nothing
  setup candidateChangesBeforeReopen() returns Nothing
  setup openingStatusDoesNotMatchNamedStatus() returns Nothing
  // Forward the real successful close, then report EIO; no claim about a genuinely failed OS close.
  setup closeReportsErrorAfterPhysicalClose(phase: Text) returns Nothing
  action captureInitialSnapshot() returns Nothing
  action readSnapshot() returns Nothing
  observation initialSnapshotIsComplete() returns Boolean
  observation initialCapturedFileText() returns Text
  observation snapshotIsComplete() returns Boolean
  observation capturedFileText() returns Text
  observation selectedFileWasCaptured() returns Boolean
  observation selectedProblemCode() returns Text
  // Counts concern the selected file during the operation, excluding fixture setup and root checks.
  observation namedStatusReads() returns Number
  observation descriptorStatusReads() returns Number
  observation bodyReads() returns Number
  observation openedDescriptors() returns Number
  observation liveDescriptors() returns Number
  observation firstClosedBeforeReopen() returns Boolean
  observation confirmationWasStrict() returns Boolean
  observation firstActualBody() returns Text
  observation secondActualBody() returns Text
  observation originalOpeningAnchorDisagreed() returns Boolean
  observation settledAndFreshCandidatesDisagreedOnlyInStatus() returns Boolean

  check expectInitialCompleteFile(expected: Text) {
    assert initialSnapshotIsComplete()
    assert initialCapturedFileText() == expected
  }
  check expectCompleteFile(expected: Text) {
    assert snapshotIsComplete()
    assert selectedFileWasCaptured()
    let actual = capturedFileText()
    assert actual == expected
    assert selectedProblemCode() == ""
  }
  check expectRefusal(code: Text) {
    assert not snapshotIsComplete()
    assert not selectedFileWasCaptured()
    let actual = selectedProblemCode()
    assert actual == code
  }
  check expectStableStatusReads() {
    assert namedStatusReads() == 2
    assert descriptorStatusReads() == 2
  }
  check expectReadCounts(reads: Number, opens: Number) {
    assert bodyReads() == reads
    assert openedDescriptors() == opens
  }
  check expectNoThirdRead() {
    assert bodyReads() <= 2
    assert openedDescriptors() <= 2
  }
  check expectClosedDescriptors() {
    assert liveDescriptors() == 0
  }
  check expectClosedBeforeReopen() {
    assert firstClosedBeforeReopen()
  }
  check expectStrictConfirmation() {
    assert confirmationWasStrict()
  }
  check expectActualBodies(first: Text, second: Text) {
    assert firstActualBody() == first
    assert secondActualBody() == second
  }
  check expectOriginalOpeningMismatch() {
    assert originalOpeningAnchorDisagreed()
  }
  check expectOnlyCandidateStatusMismatch() {
    assert settledAndFreshCandidatesDisagreedOnlyInStatus()
  }

  scenario "capture stable project files with one body read" {
    given snapshotProject(fileName, original)
    when captureInitialSnapshot()
    then expectCompleteFile(original)
    then expectReadCounts(1, 1)
    then expectStableStatusReads()
    then expectClosedDescriptors()
  }
  scenario "confirm unchanged project bytes after one initial status transition" {
    given snapshotProject(fileName, original)
    given statusChangesDuringRead("first")
    when captureInitialSnapshot()
    then expectCompleteFile(original)
    then expectActualBodies(original, original)
    then expectStrictConfirmation()
    then expectReadCounts(2, 2)
    then expectClosedBeforeReopen()
    then expectClosedDescriptors()
  }
  scenario "keep an ordinary snapshot read strict for the same transition" {
    given snapshotProject(fileName, original)
    given statusChangesDuringRead("first")
    when readSnapshot()
    then expectRefusal("changed-during-read")
    then expectReadCounts(1, 1)
    then expectClosedDescriptors()
  }
  scenario "keep a later snapshot read strict after successful initial capture" {
    given capturedSnapshotProject(fileName, original)
    given statusChangesDuringRead("next")
    when readSnapshot()
    then expectInitialCompleteFile(original)
    then expectRefusal("changed-during-read")
    then expectReadCounts(2, 2)
    then expectClosedDescriptors()
  }
  scenario "refuse equal-size changed actual bytes despite a stable confirmation" {
    given snapshotProject(fileName, original)
    given replaceBetweenReads(replacement)
    when captureInitialSnapshot()
    then expectActualBodies(original, replacement)
    then expectStrictConfirmation()
    then expectRefusal("changed-during-read")
    then expectReadCounts(2, 2)
    then expectClosedDescriptors()
  }
  scenario "refuse a stable second candidate with a different status timestamp" {
    given snapshotProject(fileName, original)
    given candidateChangesBeforeReopen()
    when captureInitialSnapshot()
    then expectOnlyCandidateStatusMismatch()
    then expectRefusal("changed-during-read")
    then expectNoThirdRead()
    then expectClosedDescriptors()
  }
  scenario "refuse another status transition during the confirming read" {
    given snapshotProject(fileName, original)
    given statusChangesDuringRead("first-and-second")
    when captureInitialSnapshot()
    then expectRefusal("changed-during-read")
    then expectReadCounts(2, 2)
    then expectClosedDescriptors()
  }
  scenario "refuse a modified-time change without a confirming read" {
    given snapshotProject(fileName, original)
    given modifiedTimeChangesDuringRead()
    when captureInitialSnapshot()
    then expectRefusal("changed-during-read")
    then expectReadCounts(1, 1)
    then expectClosedDescriptors()
  }
  scenario "refuse a mode change without a confirming read" {
    given snapshotProject(fileName, original)
    given modeChangesDuringRead()
    when captureInitialSnapshot()
    then expectRefusal("changed-during-read")
    then expectReadCounts(1, 1)
    then expectClosedDescriptors()
  }
  scenario "refuse a named-after replacement without a confirming read" {
    given snapshotProject(fileName, original)
    given nameReplacedAfterBody()
    when captureInitialSnapshot()
    then expectRefusal("changed-during-read")
    then expectReadCounts(1, 1)
    then expectClosedDescriptors()
  }
  scenario "refuse an opening status mismatch before reading a body" {
    given snapshotProject(fileName, original)
    given openingStatusDoesNotMatchNamedStatus()
    when captureInitialSnapshot()
    then expectOriginalOpeningMismatch()
    then expectRefusal("changed-during-read")
    then expectReadCounts(0, 1)
    then expectClosedDescriptors()
  }
  scenario "report a first-close error without a confirming reopen" {
    given snapshotProject(fileName, original)
    given statusChangesDuringRead("first")
    given closeReportsErrorAfterPhysicalClose("first")
    when captureInitialSnapshot()
    then expectRefusal("read-failed")
    then expectReadCounts(1, 1)
    then expectClosedDescriptors()
  }
  scenario "do not accept a confirmed candidate before its close succeeds" {
    given snapshotProject(fileName, original)
    given statusChangesDuringRead("first")
    given closeReportsErrorAfterPhysicalClose("confirming")
    when captureInitialSnapshot()
    then expectRefusal("read-failed")
    then expectReadCounts(2, 2)
    then expectClosedDescriptors()
  }
}
