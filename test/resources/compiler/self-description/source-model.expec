// Candidate source-data contract, authored by hand; not parsed or executed.
// This refines SourceDescription from the reader contract, not a second symbol.
use SourceRange from "../shared/source.expec"

type SourceNodeId {
  sourceId: Text
  ordinal: Number
}
type SourceDescription {
  sourceId: Text
  roots: List<SourceNodeId>
  nodes: List<SourceNode>
}
type SourceNode {
  id: SourceNodeId
  range: SourceRange
  payload: SourcePayload
}
type SourcePayload = NameNode | ReferenceNode | DirectiveNode | DeclarationNode | TypeNode | ExpressionNode | ImportItemNode | ParameterNode | BodyNode | ContractClauseNode | RecordEntryNode | ScenarioNode | ScenarioStepNode | ShortExampleNode | ProseExpectationNode | StatementNode | ParticipantNode | MessageNode
type DirectiveNode = UseNode | IncludeNode | ExamplesAttachmentNode
type DeclarationNode = ConceptNode | RecordTypeDeclarationNode | AliasTypeDeclarationNode | OpaqueTypeDeclarationNode | FieldNode | LocalDeclarationNode | ExtensionNode | DependenciesNode | PackageRequirementNode | PublicNode | ConstructionNode | CallableNode | ExamplesNode | FixtureNode | InteractionNode
type TypeNode = NamedTypeNode | TupleTypeNode | OptionalTypeNode | UnionTypeNode | LiteralTypeNode | GroupedTypeNode
type ExpressionNode = StringLiteralNode | NumberLiteralNode | BooleanLiteralNode | NameExpressionNode | MemberExpressionNode | CallExpressionNode | RecordExpressionNode | ListExpressionNode | UnaryExpressionNode | BinaryExpressionNode | GroupedExpressionNode
type StatementNode = LetNode | ExpressionStatementNode

type NameNode {
  kind: "name"
  decoded: Text
  quoted: Boolean
}
type ReferenceNode {
  kind: "reference"
  segments: List<SourceNodeId>
}
type UseNode {
  kind: "use"
  imports: List<SourceNodeId>
  locator: SourceNodeId
}
type ImportItemNode {
  kind: "import-item"
  imported: SourceNodeId
  alias: SourceNodeId?
}
type IncludeNode {
  kind: "include"
  locator: SourceNodeId
}
type ExamplesAttachmentNode {
  kind: "examples-attachment"
  subject: SourceNodeId
  locator: SourceNodeId
}
type ConceptNode {
  kind: "concept" | "component" | "class" | "interface"
  name: SourceNodeId
  members: List<SourceNodeId>
}
type RecordTypeDeclarationNode {
  kind: "record-type-declaration"
  name: SourceNodeId
  typeParameters: List<SourceNodeId>
  fields: List<SourceNodeId>
}
type AliasTypeDeclarationNode {
  kind: "alias-type-declaration"
  name: SourceNodeId
  typeParameters: List<SourceNodeId>
  targetType: SourceNodeId
}
type OpaqueTypeDeclarationNode {
  kind: "opaque-type-declaration"
  name: SourceNodeId
  typeParameters: List<SourceNodeId>
}
type FieldNode {
  kind: "field"
  name: SourceNodeId
  declaredType: SourceNodeId
  defaultValue: SourceNodeId?
}
type LocalDeclarationNode {
  kind: "local"
  declaration: SourceNodeId
}
type ExtensionNode {
  kind: "extend"
  target: SourceNodeId
  members: List<SourceNodeId>
}
type DependenciesNode {
  kind: "depends-on"
  references: List<SourceNodeId>
}
type PackageRequirementNode {
  kind: "requires-package"
  locator: SourceNodeId
  phase: ("build" | "runtime" | "test")?
}
type PublicNode {
  kind: "public"
  references: List<SourceNodeId>
}
type ConstructionNode {
  kind: "construction"
  parameters: List<SourceNodeId>
}
type CallableNode {
  kind: "capability" | "function" | "setup" | "action" | "observation" | "check"
  name: SourceNodeId
  parameters: List<SourceNodeId>
  returnType: SourceNodeId?
  body: SourceNodeId?
}
type ParameterNode {
  kind: "parameter"
  name: SourceNodeId
  declaredType: SourceNodeId
  defaultValue: SourceNodeId?
}
type BodyNode {
  kind: "contract-body" | "helper-body" | "check-body"
  members: List<SourceNodeId>
}
type ContractClauseNode {
  kind: "promises" | "requires" | "ensures"
  content: SourceNodeId
}
type ExamplesNode {
  kind: "examples"
  subject: SourceNodeId?
  members: List<SourceNodeId>
}
type FixtureNode {
  kind: "fixture"
  name: SourceNodeId
  declaredType: SourceNodeId
  value: SourceNodeId
}
type LetNode {
  kind: "let"
  name: SourceNodeId
  value: SourceNodeId
}
type ExpressionStatementNode {
  kind: "do" | "return" | "assert"
  expression: SourceNodeId
}
type ScenarioNode {
  kind: "scenario"
  title: SourceNodeId
  steps: List<SourceNodeId>
}
type ScenarioStepNode {
  kind: "given" | "when" | "then"
  capture: SourceNodeId?
  content: SourceNodeId
}
type ShortExampleNode {
  kind: "example"
  title: SourceNodeId
  actual: SourceNodeId
  expected: SourceNodeId
}
type ProseExpectationNode {
  kind: "prose-expectation"
  text: SourceNodeId
}
type InteractionNode {
  kind: "interaction"
  title: SourceNodeId
  parameters: List<SourceNodeId>
  members: List<SourceNodeId>
}
type ParticipantNode {
  kind: "participant"
  name: SourceNodeId
  declaredType: SourceNodeId
}
type MessageNode {
  kind: "message"
  sender: SourceNodeId
  receiver: SourceNodeId
  operation: SourceNodeId
  arguments: List<SourceNodeId>
  capture: SourceNodeId?
}
type NamedTypeNode {
  kind: "named-type"
  reference: SourceNodeId
  arguments: List<SourceNodeId>
}
type TupleTypeNode {
  kind: "tuple-type"
  elements: List<SourceNodeId>
}
type OptionalTypeNode {
  kind: "optional-type"
  inner: SourceNodeId
}
type UnionTypeNode {
  kind: "union-type"
  alternatives: List<SourceNodeId>
}
type LiteralTypeNode {
  kind: "literal-type"
  value: SourceNodeId
  negative: Boolean
}
type GroupedTypeNode {
  kind: "grouped-type"
  inner: SourceNodeId
}
type StringLiteralNode {
  kind: "string-literal"
  value: Text
}
type NumberLiteralNode {
  kind: "number-literal"
  token: Text
}
type BooleanLiteralNode {
  kind: "boolean-literal"
  value: Boolean
}
type NameExpressionNode {
  kind: "name-expression"
  reference: SourceNodeId
}
type MemberExpressionNode {
  kind: "member-expression"
  receiver: SourceNodeId
  member: SourceNodeId
}
type CallExpressionNode {
  kind: "call-expression"
  callee: SourceNodeId
  arguments: List<SourceNodeId>
}
type RecordExpressionNode {
  kind: "record-expression"
  declaredType: SourceNodeId?
  entries: List<SourceNodeId>
}
type RecordEntryNode {
  kind: "record-entry"
  name: SourceNodeId
  value: SourceNodeId
}
type ListExpressionNode {
  kind: "list-expression"
  elements: List<SourceNodeId>
}
type UnaryExpressionNode {
  kind: "unary-expression"
  operator: "+" | "-" | "not"
  operatorRange: SourceRange
  operand: SourceNodeId
}
type BinaryExpressionNode {
  kind: "binary-expression"
  operator: "+" | "-" | "*" | "/" | "%" | "==" | "!=" | "<" | "<=" | ">" | ">=" | "and" | "or"
  operatorRange: SourceRange
  left: SourceNodeId
  right: SourceNodeId
}
type GroupedExpressionNode {
  kind: "grouped-expression"
  inner: SourceNodeId
}
