// Candidate 0.1 self-description, authored by hand; not parsed or executed.
// Text is a primitive. Builtin types are available without imports.
// read and ReadResult are the agreed operation and working result names.

use SourceDocument, SourceRange from "../shared/source.expec"
use SourceDescription from "../compiler/source-model.expec"

type SyntaxDiagnostic {
  category: "unexpected-token" | "expected-token" | "unterminated-string" | "unterminated-name" | "invalid-escape" | "invalid-character"
  explanation: Text
  primaryRange: SourceRange
  relatedRanges: List<SourceRange>
}

// CORE-18 now supplies the concrete source-description contract. The public
// read/ReadResult behavior and original-source range conventions are unchanged.

type AcceptedSource {
  status: "accepted"
  grammarVersion: "candidate-0.1"
  document: SourceDocument
  description: SourceDescription
}

type RejectedSource {
  status: "rejected"
  grammarVersion: "candidate-0.1"
  document: SourceDocument
  diagnostics: List<SyntaxDiagnostic>
}

type ReadResult = AcceptedSource | RejectedSource

interface SyntaxReader {
  depends on SourceDocument, ReadResult
  public read
  capability read(source: SourceDocument) returns ReadResult {
    promises "Recognize candidate-0.1 source forms and preserve their authored meaning and source locations"
    promises "Return an accepted description or reject with at least one actual syntax diagnostic"
    promises "Keep declarations distinct from references, without resolving or inventing unavailable names"
    promises "Treat explicit prose as an obligation, not as an executed comparison"
    promises "Recognize requests for other sources without loading them or modifying a project"
  }
}
