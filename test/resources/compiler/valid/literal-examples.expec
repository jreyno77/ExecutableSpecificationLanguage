function multiply(a: Number, b: Number) returns Number
function title() returns Text
examples {
  example "eight times eight": multiply(8, 8) => 64
  example "a literal title": title() => "Dune"
  example "a descriptive result": multiply(8, 8) => satisfies "A nonnegative pair of digits starting with 6 and ending with 4."
  scenario "an ordinary function supplies a value" {
    when displayed = title()
    then displayed == "Dune"
  }
}
