interface Storage {
  public persist
  capability persist(snapshot: Text) returns Text
}
component Screen {
  public showSaved
  capability showSaved(receipt: Text) returns Nothing
  interaction "reply used before capture"(snapshot: Text) {
    participant screen: Screen
    participant storage: Storage
    message storage -> screen.showSaved(receipt)
    message screen -> storage.persist(snapshot) as receipt
  }
}
