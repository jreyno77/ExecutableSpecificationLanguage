// Draft self-description: candidate notation, not a compiled specification.
// The manifest explicitly provides core.Text, core.Boolean, and core.List.

"ExpecCompiler"
dependencies: Specification, ValidationResult, BuildManifest, BuildResult
userFacingCapabilities: "validate", "build"

"validate"(specification: Specification) returns ValidationResult
  => "Every referenced name resolves to a declaration available in scope, or validation reports the unresolved name and its location."

"build"(specification: Specification, manifest: BuildManifest) returns BuildResult
  => "A valid specification updates the project connected in the manifest for its selected targets while preserving handwritten implementations."
  => "If no project is connected, the user is asked whether to initialize one."
  => "An invalid specification reports its errors and does not apply a replacement build."

"Specification" type
dependencies: SourceFile, core.List
files: core.List<SourceFile>

"SourceFile" type
dependencies: core.Text
path: core.Text
content: core.Text

"ValidationResult" type
dependencies: Diagnostic, core.Boolean, core.List
valid: core.Boolean
diagnostics: core.List<Diagnostic>

"Diagnostic" type
dependencies: core.Text
name: core.Text
sourcePath: core.Text
location: core.Text
message: core.Text

"BuildManifest" type
dependencies: ProjectConnection, OutputTarget, Dependency, core.Text, core.List
version: core.Text
connection: ProjectConnection
targets: core.List<OutputTarget>
requiredDependencies: core.List<Dependency>

"ProjectConnection" type
dependencies: core.Boolean, core.Text
connected: core.Boolean
root: core.Text

"OutputTarget" type
dependencies: core.Text
name: core.Text
outputDirectory: core.Text

"Dependency" type
dependencies: core.Text
name: core.Text
source: core.Text

"BuildResult" type
dependencies: Diagnostic, ProjectChange, core.Text, core.List
status: core.Text
diagnostics: core.List<Diagnostic>
changes: core.List<ProjectChange>

"ProjectChange" type
dependencies: core.Text
kind: core.Text
path: core.Text
description: core.Text
