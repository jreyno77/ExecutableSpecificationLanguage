// Draft self-description only: not parsed, compiled, or implemented.
// Construction and opaque-type notation are provisional.
// Opaque declarations deliberately leave identifier encodings and result schemas open.

use ProjectConnection from "./compiler.expec"

"SpecOutput"
dependencies: ResolvedSpecification, SpecDiff, SpecIdentifier, OutputOptions, ProjectContext, ChangeResult, ConceptContent, ConceptSearch
construction(options: OutputOptions, projectContext: ProjectContext)
userFacingCapabilities: "create", "insert", "update", "read", "search", "delete"

"create"(spec: ResolvedSpecification) returns ChangeResult
  => "Create the configured target representation in the connected project, preserving existing handwritten work."

"insert"(specDiff: SpecDiff) returns ChangeResult
  => "Insert specified additions using the current project context and the output instance's configured options."

"update"(specDiff: SpecDiff) returns ChangeResult
  => "Apply specified changes to the current project while preserving handwritten implementations and reporting conflicts."

"read"(identifier: SpecIdentifier) returns ConceptContent
  => "Return all current content of the identified concept's target representation, including handwritten code and every constituent source or artifact part."
  => "Read current project state rather than only a signature, generated region, or previous build snapshot."

"search"(identifier: SpecIdentifier) returns ConceptSearch
  => "Find the definition and all uses of the identified thing throughout the current connected project."
  => "Expose actual outgoing dependencies and incoming consumers, including components not represented in the specification."
  => "Provide the actual relationships needed to detect expected dependencies a,b,c versus actual dependencies a,b,d."
  => "Do not change the project or silently turn discovered code into source-language declarations."

"delete"(identifier: SpecIdentifier) returns ChangeResult
  => "Remove the associated target representation according to the code-preservation policy, reporting conflicts where handwritten work would otherwise be lost."

"ProjectContext"
dependencies: ProjectConnection, ProjectState
construction(connection: ProjectConnection)
userFacingCapabilities: "current"

"current"() returns ProjectState
  => "Provide the connected project's current content and relationships, including changes made after this component was constructed."

"ResolvedSpecification" opaque type
// The shared, validated specification model; detailed schema is undecided.

"SpecDiff" opaque type
// Changes to specification meaning; detailed schema is undecided.

"SpecIdentifier" opaque type
// Identity representation is intentionally not a concept-name string or fixed encoding yet.

"OutputOptions" opaque type
// Configured target-specific options, supplied at construction.

"ProjectState" opaque type
// Live project information supplied by the context component.

"ChangeResult" opaque type
// Change outcome and diagnostics; result schema is undecided.

"ConceptContent" opaque type
// Complete current representation, including all content and its source/artifact locations.

"ConceptSearch" opaque type
// Definitions, uses, dependencies, and consumers, including project-only code.
// Coverage metadata and comparison-result placement are proposed, not settled fields.
