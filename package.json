{
  "name": "executable-specification-language",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "description": "A compiler for readable executable software specifications.",
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=11.20.0 <12"
  },
  "packageManager": "npm@11.20.0",
  "scripts": {
    "grammar:generate": "langium generate",
    "build": "npm run grammar:generate && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:acceptance": "vitest run test/acceptance",
    "test:package": "npm run build && vitest run --config vitest.package.config.ts",
    "test:watch": "vitest --watch",
    "dev": "npm run grammar:generate && npm run test:watch",
    "check": "npm run grammar:generate && npm run typecheck && npm run test:unit && npm run test:acceptance && tsc -p tsconfig.build.json",
    "release": "npm pack"
  },
  "dependencies": {
    "langium": "4.4.0"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "langium-cli": "4.4.0",
    "typescript": "5.9.3",
    "vitest": "5.0.2"
  }
}
