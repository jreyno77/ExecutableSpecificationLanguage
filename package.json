{
  "name": "executable-specification-language",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "description": "A compiler for readable executable software specifications.",
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=11.20.0 <12"
  },
  "packageManager": "npm@11.20.0",
  "scripts": {
    "grammar:generate": "langium generate",
    "build": "npm run grammar:generate && tsc -p tsconfig.build.json && npm run python:build",
    "python:build": "node src/python-build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:acceptance": "vitest run test/acceptance --maxWorkers=2",
    "test:package": "npm run build && vitest run --config vitest.package.config.ts",
    "test:watch": "vitest --watch",
    "dev": "npm run grammar:generate && npm run test:watch",
    "check": "npm run grammar:generate && npm run typecheck && npm run test:unit && npm run test:acceptance && tsc -p tsconfig.build.json",
    "release": "npm pack"
  },
  "dependencies": {
    "@d2lang/d2": "0.1.34",
    "cross-spawn": "7.0.6",
    "jsonc-parser": "3.3.1",
    "langium": "4.4.0",
    "mdast-util-from-markdown": "2.0.3",
    "semver": "7.8.5",
    "typescript": "5.9.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/cross-spawn": "6.0.6",
    "@types/node": "24.13.6",
    "@types/semver": "7.8.0",
    "@xmldom/xmldom": "0.9.12",
    "langium-cli": "4.4.0",
    "vitest": "5.0.2"
  }
}
